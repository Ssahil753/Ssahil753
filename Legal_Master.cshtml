<script>
    function Fill_District() {
        var Data =
        {
            OPD_NO: '',
            Query_Parameter: 'Department'
        };
        $.ajax({
            url: rootUrl + "api/Legal_master/Fill_district",
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(Data),
            success: function (data) {
                var s = '<option value="-1">---Select---</option>';
                //var s = '';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].district_name + '">' + data[i].district_name + '</option>';
                }
                $("#district_name").html(s);                
            }
        }
        );
    };
</script>

<script>
    function Fill_Taluka() {
        var Data =
        {
            OPD_NO: '',
            district_name: $("#district_name").val()
        };

        
        $.ajax({
            url: rootUrl + "api/Legal_master/Fill_taluka",
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(Data),
            success: function (data) {
                
