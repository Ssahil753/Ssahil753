<script type="text/javascript">
    function Validate() {
        var isValid = true;
        var UserName = $.trim($("#UserName").val()).length;
        if (UserName == 0) {
            alert('User Name should not be blank.');
            $('#UserName').focus();
            isValid = false;
            return false;
        }
        var UserPassword = $.trim($("#UserPassword").val()).length;
        if (UserPassword == 0) {
            alert('User Password should not be blank.');
            $('#UserPassword').focus();
            isValid = false;
            return false;
        }
        return isValid;
    }
</script>



<script type="text/javascript">
    $(function () {


        $("#UserName").keypress(function (e) {
            var keyCode = e.keyCode || e.which;
            var regex = /^[A-Za-z0-9-_@@!#$%^&* ]+$/;
            var isValid = regex.test(String.fromCharCode(keyCode));
            if (!isValid) {
                alert("Only Alphabets and Numbers allowed.");
            }
            return isValid;
        });
    });
    $(function () {
        $("#UserPassword").keypress(function (e) {
            var keyCode = e.keyCode || e.which;
            var regex = /^[A-Za-z0-9-_@@!#$%^&* ]+$/;
            var isValid = regex.test(String.fromCharCode(keyCode));
            if (!isValid) {
                alert("Only Alphabets and Numbers allowed.");
            }
            return isValid;
        });
    });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $('input:text').bind('cut copy paste', function (e) {
            e.preventDefault();
            alert("Cut / Copy / Paste Disabled");
        });

        $('#linkClose').click(function () {
            $('#divError').hide('fade');
        });
        $('#btnLogin').click(function () {
            var res = Validate();
            if (res == false) {
                return false;
            }
          
            var Data =
            {
                'username': $('#UserName').val(),
                'password': $('#UserPassword').val(),
                'token': 'Token String',
            };
            //alert(rootUrl + "api/Token/CreateToken");
            $.ajax({
                url: rootUrl + "api/Token/CreateToken",
                method: 'Post',
                contentType: "application/json;charset=utf-8",
                dataType: 'Text',
                data: JSON.stringify(Data),
                options:
                {
                    expiresIn: 86400
                },
                // When the request completes successfully,save the access token in the browser session storage
                success: function (response) {
                   // alert('OK');
                    sessionStorage.setItem("UserName", $('#UserName').val());
                    sessionStorage.setItem("accessToken", response);
                    location.href = rootUrl + "Home/Dashboard";
                },
                // Display errors if any in the Bootstrap alert <div>
                error: function (jqXHR) {
                   // alert(jqXHR);
                    alert('User is not authorized.');
                },
            });
        });
    });
</script>
<script type="text/javascript">
    function Authorize() {
        var token = sessionStorage.getItem("accessToken");
        if (token == null) {
            alert('Token has expired.');
            return false
        }
        var Data =
        {
            'username': $('#UserName').val(),
            'password': $('#UserPasswordrootUrl').val(),
            'token': token,
        };
        $.ajax({
            method: 'Post',
            url: rootUrl + "api/Token/Authorize",
            dataType: 'Text',
            async: false,
            data: JSON.stringify(Data),
            contentType: "application/json;charset=utf-8",
            beforeSend: function (xhr) {
                xhr.setRequestHeader('Authorization', 'Bearer ' + token);
            },
            success: function (result) {
                var UserAttributes = new Array();
                UserAttributes = result.split("_");
                $('#UserName').val(UserAttributes[1]);
                $('#User_ID').val(UserAttributes[2]);
                $('#basePath').val(UserAttributes[3]);
                sessionStorage.setItem("UserAttributes", UserAttributes);
            },
            error: function (result) {

            }
        });
    }
</script>
