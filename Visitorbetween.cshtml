                </div>
            </div>
        </div>
    </div>
</div>

    <script>
               $(document).ready(function () {
            var rootUrl = '@Url.Content("~/")';

            $('#dateRangeForm').submit(function (event) {
                event.preventDefault(); // Prevent default form submission

                // Get selected start and end date values
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();

                // Validate if both dates are selected
                if (!startDate || !endDate) {
                    alert("Please select both start and end dates.");
                    return;
                }

                // Create a date range object
                var dateRange = {
                    Visitor_In_Time: startDate,
                    Visitor_Out_Time: endDate
                };

                // AJAX request to send the date range and get filtered data
                $.ajax({
                    type: "POST",
                    url: rootUrl + "api/Visitor_Master/Select_Visitor", // Adjust API endpoint if needed
                    data: JSON.stringify(dateRange),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        // Initialize or update the DataTable
                        $('#Grid').DataTable({
                            bLengthChange: true,
                            lengthMenu: [[10, 20, -1], [10, 20, "All"]],
                            bFilter: true,
                            bSort: true,
                            bPaginate: true,
                            destroy: true,
                            data: response,
                            columns: [
                                { 'data': 'sr_no', class: "text-right" },
                                { 'data': 'visitor_In_Time_New' },
                                { 'data': 'visitor_Out_Time_New' },
                                { 'data': 'visitor_Name' },
                                { 'data': 'mobile_No' },
                                { 'data': 'dept_Id' },
                                { 'data': 'whom_To_Meet' },
                                { 'data': 'address' },
                                { 'data': 'purpose_Of_Visit' },
                                { 'data': 'email_Id' },
                                { 'data': 'outing_Remark' },
                                { 'data': 'electronic_Accessories' },
                                { 'data': 'make' },
                                { 'data': 'serial_Number' },
                                { 'data': 'photo', class: "text-hide" },
                                {
                                    'mRender': function (data, type, row) {
                                        return '<input type="button" class="btn btn-sm btn-info btnClass" value="Print"/>';
                                    }
                                },
                                {
                                    'mRender': function (data, type, row) {
                                        return '<input type="button" class="btn btn-sm btn-info btnClass" value="Edit"/>';
                                    }
                                },
                                { 'data': 'id', class: "text-hide" },
                                { 'data': 'qrCode', class: "text-hide" },
                            ]
                        });
                    },
                    error: function (xhr, status, error) {
                        alert("Error: " + error);
                    }
                });
            });
        });

    </script>
    <script>
    // Function to handle closing the modals
    function closeModal(modalId) {
    // Hide the modal window
    $("#" + modalId).modal("hide");

    // Optionally, restore visibility or perform other actions when the modal is closed
    // For example, if you had hidden buttons or content:
    // $('#someButton').show();
    // Or clearing inputs:
    // $("#someInputField").val('');
    }

    // Bind the close action for both buttons
    $("#CloseP").click(function() {
    closeModal("Print"); // Close the "Print" modal
    });

    $("#Close").click(function() {
    closeModal("Edit"); // Close the "Edit" modal
    });
    </script>
    <script type="text/javascript">


        function OnSuccess(response)
        {

            $("#Grid").DataTable(
                {
                    bLengthChange: true,
                    lengthMenu: [[10, 20, -1], [10, 20, "All"]],
                    bFilter: true,
                    bSort: true,
                    bPaginate: true,
                    destroy: true,
                    data: response,
                    columns: [
                        { 'data': 'sr_no', class: "text-right" },
                        { 'data': 'visitor_In_Time_New'},
                        { 'data': 'visitor_Out_Time_New' },
                        { 'data': 'visitor_Name' },
                        { 'data': 'mobile_No' },
                        { 'data': 'dept_Id'},
                        { 'data': 'whom_To_Meet' },
                        { 'data': 'address'},
                        { 'data': 'purpose_Of_Visit' },
                        { 'data': 'email_Id'},
                        { 'data': 'outing_Remark'},
                        { 'data': 'electronic_Accessories' },
                        { 'data': 'make' },
                        { 'data': 'serial_Number' },
                        { 'data': 'photo', class: "text-hide" },
                        {
                            'mRender': function (data, type, row) {
                                return '<input type="button" class="btn btn-sm btn-info btnClass" value="Print"/>';
                            }
                        },
                        {
                            'mRender': function (data, type, row) {
                                return '<input type="button" class="btn btn-sm btn-info btnClass" value="Edit"/>';
                            }
                        },
                        { 'data': 'id', class: "text-hide" },
                        { 'data': 'qrCode', class: "text-hide" },
                    ]
                });
        };
        function Select_Visitor() {
            // Authenticate();
            var token = sessionStorage.getItem("accessToken");
            if (token == null) {
                alert('Token has expired.');
                return false
            }
            var Data =
            {
                Id: "0",
            };
            $.ajax({
                type: "POST",
                url: rootUrl + "api/Visitor_Master/Select_Visitor",
                data: JSON.stringify(Data),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                },
                success: OnSuccess,
                failure: function (response)
                {

                   // alert(response.d);
                },
                error: function (response) {

                    //alert(response);
                }
            });
        };
    </script>

    <script>
        $('#Save').click(function () {
            Update_Visitor();
        });
    </script>

    <script language="javascript" type="text/javascript">
        function Update_Visitor() {
            var res = Validate();
            if (res == false)
            {
                return false;
            }

            var Data =
            {
                Id:  $("#Id").val(),
                Outing_Remark: $('#Outing_Remark').val(),
            };
            $.ajax({
                url: rootUrl + "api/Visitor_Master/Update_Visitor",
                type: "Post",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                data: JSON.stringify(Data),
                success: function (result) {
                    alert("Record is Updated Successfully.");
                    Select_Visitor();
                    Clear_Data();
                    $('#Edit').modal("hide");

                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }
    </script>
    <script type="text/javascript">
        function Clear_Data() {
            $('#username').val("");
            $('#user_id').val("0");
        }
    </script>
    <script type="text/javascript">
        function Validate() {
            var isValid = true;
            var Outing_Remark = $.trim($("#Outing_Remark").val()).length;
            if (Outing_Remark == "0") {
                alert('Outing Remark should not be blank.');
                $('#Outing_Remark').focus();
                isValid = false;
                return false;
            }
            return isValid;
        }
    </script>
    <script type="text/javascript">
        function Authenticate() {
            var token = sessionStorage.getItem("accessToken");
            if (token == null)
            {
                alert('Token has expired.');
                return false
            }
            $.ajax({
                type: "GET",
                url: rootUrl + "api/data/authenticate",
                dataType: 'json',
                async: false,
                beforeSend: function (xhr) {
                    xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                },
                success: function (result) {
                    var total = result.length;
                    if (total != 0) {
                        var UserAttributes = new Array();
                        UserAttributes = result.split("_");
                        $('#UserName').val(UserAttributes[0]);
                        $('#User_ID').val(UserAttributes[1]);
                        $('#basePath').val(UserAttributes[3]);
                    }
                    //alert('User has Authenticated');
                }
            });
        }
    </script>

    <script>


        $('#Grid').on('click', '.btnClass', function () {
        if ($(this).val() == "Edit") // Get the button's value)
        {
            var v = $(this).val();
            $("#Edit").modal("show");
            $('#Save').val("Update");

            // Get values from the selected row
            var Visitor_In_Time = $(this).closest('tr').children('td:eq(1)').text();
            var Visitor_Out_Time = $(this).closest('tr').children('td:eq(2)').text();
            var Visitor_Name = $(this).closest('tr').children('td:eq(3)').text();
            var Mobile_No = $(this).closest('tr').children('td:eq(4)').text();
            var dept_Id = $(this).closest('tr').children('td:eq(5)').text();
            var Whom_To_Meet = $(this).closest('tr').children('td:eq(6)').text();
            var Address = $(this).closest('tr').children('td:eq(7)').text();
            var Reason_To_Meet = $(this).closest('tr').children('td:eq(8)').text();
            var Email_Id = $(this).closest('tr').children('td:eq(9)').text();
            var Electronic_Accessories = $(this).closest('tr').children('td:eq(11)').text();
            var Make = $(this).closest('tr').children('td:eq(12)').text();
            var Serial_Number = $(this).closest('tr').children('td:eq(13)').text();
            var Photo = $(this).closest('tr').children('td:eq(14)').text();
            var Id = $(this).closest('tr').children('td:eq(17)').text();

            // Populate form fields
            $("#Visitor_In_Time").val(Visitor_In_Time);
            $("#Visitor_Name").val(Visitor_Name);
            $("#Mobile_No").val(Mobile_No);
            $("#dept_Id").val(dept_Id);
            $("#Whom_To_Meet").val(Whom_To_Meet);
            $("#Email_Id").val(Email_Id);
            $("#Address").val(Address);
            $("#Reason_To_Meet").val(Reason_To_Meet);
            $("#Electronic_Accessories").val(Electronic_Accessories);
            $("#Make").val(Make);
            $("#Serial_Number").val(Serial_Number);
            $("#Id").val(Id);

            // Show/hide Make and Serial Number fields based on Electronic Accessories
            if (Electronic_Accessories == "Laptop") {
                $('#Brand').css('visibility', 'visible');
                $('#SN').css('visibility', 'visible');
            } else {
                $('#Brand').css('visibility', 'hidden');
                $('#SN').css('visibility', 'hidden');
            }
        }
            if ($(this).val() == "Print") // Get the button's value
            {
                var v = $(this).val();
                $("#Print").modal("show");
                $('#Save').val("Update");

                // Get values from the selected row
                var Visitor_In_Time = $(this).closest('tr').children('td:eq(1)').text();
                var Visitor_Out_Time = $(this).closest('tr').children('td:eq(2)').text();
                var Visitor_Name = $(this).closest('tr').children('td:eq(3)').text();
                var Mobile_No = $(this).closest('tr').children('td:eq(4)').text();
                var dept_Id = $(this).closest('tr').children('td:eq(5)').text();
                var Whom_To_Meet = $(this).closest('tr').children('td:eq(6)').text();
                var Address = $(this).closest('tr').children('td:eq(7)').text();
                var Reason_To_Meet = $(this).closest('tr').children('td:eq(8)').text();
                var Email_Id = $(this).closest('tr').children('td:eq(9)').text();
                var Electronic_Accessoriesp = $(this).closest('tr').children('td:eq(11)').text();
                var Make = $(this).closest('tr').children('td:eq(12)').text();
                var Serial_Number = $(this).closest('tr').children('td:eq(13)').text();
                var Photo = $(this).closest('tr').children('td:eq(14)').text();
                var Id = $(this).closest('tr').children('td:eq(15)').text();
                var qrcode = $(this).closest('tr').children('td:eq(18)').text();

                // Bind QR Code
                $("#qrcode").attr('src', qrcode);

                // Populate print modal fields
                $("#Visitor_Namep").text(Visitor_Name);
                $("#Visitor_In_Timep").text(Visitor_In_Time);
                $("#Mobile_Nop").text(Mobile_No);
                $("#dept_Idp").text(dept_Id);
                $("#Whom_To_Meetp").text(Whom_To_Meet);
                $("#Email_Idp").text(Email_Id);
                $("#Addressp").text(Address);
                $("#Reason_To_Meetp").text(Reason_To_Meet);
                $("#Id").val(Id);
                $("#Electronic_Accessoriesp").text(Electronic_Accessoriesp);

                // Show Make and Serial Number only for Laptop
                if (Electronic_Accessoriesp === "Laptop") {
                    $("#Makep").text(Make);
                    $("#Serial_Numberp").text(Serial_Number);
                    // Show the labels for Make and Serial Number
                    $("label[for='Makep'], label[for='Serial_Numberp']").show();
                    $("#Makep, #Serial_Numberp").show();
                } else {
                    $("#Makep").text('');
                    $("#Serial_Numberp").text('');
                    // Hide the labels for Make and Serial Number
                    $("label[for='Makep'], label[for='Serial_Numberp']").hide();
                    $("#Makep, #Serial_Numberp").hide();
                }

                // Set the photo (base64)
                var base64String = Photo; // Replace with actual base64 image string
                $('#Photo').attr('src', base64String).show();
            }
        });
    </script>

    <script>
           function Print() {
            var printButton = document.getElementById("PrintBtn");
            var closeButton = document.getElementById("CloseP");

            // Set the print button visibility to 'hidden'
            printButton.style.visibility = 'hidden';
            closeButton.style.visibility = 'hidden';

            // Get the content to be printed
            var prtContent = document.getElementById("Print");

            // Open a new window for printing
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.focus();
            WinPrint.print();

            // Monitor the print window for when it is closed
            var printWindowCheck = setInterval(function() {
                if (WinPrint.closed) {
                    // Once the print window is closed, restore the visibility of buttons
                    printButton.style.visibility = 'visible';
                    closeButton.style.visibility = 'visible';
                    clearInterval(printWindowCheck); // Stop checking once the window is closed
                }
            }, 100); // Check every 100ms
        }

    </script>

    @if (ViewData["Message"] != null)
        {
            <div class="alert alert-info mt-3">
                <strong>Result:</strong> @ViewData["Message"]
            </div>
        }
    </div>

