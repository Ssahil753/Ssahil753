                            <th width="5%">#</th>
                            <th>Visitor Check In</th>
                            <th>Visitor Check Out</th>
                            <th>Visitor Name</th>
                            <th>Mobile No</th>
                            <th>Department</th>
                            <th>Whom To Meet</th>
                            <th>Address</th>
                            <th>Purpose Of Visit</th>
                            <th>Email ID</th>
                            <th>Outing Remark</th>
                            <th>Electronic Accessories</th>
                            <th>Make</th>
                            <th>Serial_Number</th>
                            <th>Photo</th>
                            <th>Print</th>
                            <th>Edit</th>
                            <th hidden="hidden">Id</th>
                            <th hidden="hidden">QrCode</th>
                        </tr>
                    </thead>
                </table>
           
        </div>

    </div>
    <div class="clearfix"></div>
