                }
            });
        }

        // Prepare data for Purpose of Visit chart
        function preparePurposeVisitData(response) {
        console.log(preparePurposeVisitData);
        debugger;
            var purposeData = {};
            response.forEach(function(visitor) {
                var purpose = visitor.purpose_Of_Visit;
                if (purposeData[purpose]) {
                    purposeData[purpose]++;
                } else {
                    purposeData[purpose] = 1;
                }
            });

            var purposeLabels = Object.keys(purposeData);
            var purposeValues = Object.values(purposeData);

            // Log data to verify
            console.log("Purpose of Visit Data:", purposeLabels, purposeValues);

            // Create the Purpose of Visit donut chart
            var purposeChartCanvas = $('#purposeDonutChart').get(0).getContext('2d');
            var purposeDonutData = {
                labels: purposeLabels,
                datasets: [{
                    data: purposeValues,
                    backgroundColor: ['#f39c12', '#00a65a', '#00c0ef', '#f56954', '#3c8dbc','#ff2147'], // Colors for each slice
                }]
            };
            var purposeDonutOptions = {
                maintainAspectRatio: false,
                responsive: true,
            };
            var purposeDonutChart = new Chart(purposeChartCanvas, {
                type: 'doughnut',
                data: purposeDonutData,
                options: purposeDonutOptions
            });
        }

        // Prepare data for Category chart
        function prepareCategoryData(response) {
        console.log(prepareCategoryData);
        debugger;
            var categoryData = {};
            response.forEach(function(visitor) {
                var category = visitor.category;
                if (categoryData[category]) {
                    categoryData[category]++;
                } else {
                    categoryData[category] = 1;
                }
            });

            var categoryLabels = Object.keys(categoryData);
            var categoryValues = Object.values(categoryData);

            // Log data to verify
            console.log("Category Data:", categoryLabels, categoryValues);

            // Create the Category donut chart
            var categoryChartCanvas = $('#categoryDonutChart').get(0).getContext('2d');
            var categoryDonutData = {
                labels: categoryLabels,
                datasets: [{
                    data: categoryValues,
                backgroundColor: ['#00a65a', '#f39c12','#00c0ef' ,'#f56954', '#3c8dbc','#ff2147'], // Colors for each slice
                }]
            };
            var categoryDonutOptions = {
                maintainAspectRatio: false,
                responsive: true,
            };
            var categoryDonutChart = new Chart(categoryChartCanvas, {
                type: 'doughnut',
                data: categoryDonutData,
                options: categoryDonutOptions
            });
        }
    </script>
