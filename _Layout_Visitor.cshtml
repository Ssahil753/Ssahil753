<script>
    $(document).ready(function ()
    {

        var rootUrl = '@Url.Content("~/")';
        var token = sessionStorage.getItem("accessToken");
        var expires_in = sessionStorage.getItem("expires_in");
        if (token == null) {
            alert('Your Token is expired.');
            Token_Expired();
            return false
        }
        Authenticate(token);
    });
</script>
<script type="text/javascript">
    function Authenticate(token)
    {
        $("li").hide();
        var Data =
        {
            token: token,
        };
        var rootUrl = '@Url.Content("~/")';
        $.ajax({

            type: "POST",
            url: rootUrl + "api/User_Login/Select_User_Attributes",
            data: JSON.stringify(Data),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {
                $('#user_id').val(result.USER_ID);
                $('#user_name').val(result.USERNAME);
                $('#rooturl').val(result.ROOTURL);
                $('#rolename').val(result.role_name);
                var emp_name =  result.emp_name + ' [' + result.role_name + ']';
                $('#emp_name').text(emp_name);
                //SUPERADMIN
                if ($('#rolename').val() == "Super Admin") {
                        $("#nvtanb li").each(function ()
                        {
                        var liText = $(this).text();
                        $("li").show();
                        });
                    $("#nvtanb").show();
                }
                //LEGAL

                if ($('#rolename').val() == "Legal") {
                    $("#nvtanb li").each(function () {
                        var liText = $(this).text();
                        if (liText == 'Advocate Master') $(this).show();
                        if (liText == 'Legal Case Fees Master') $(this).show();
                        if (liText == 'Advocate Fees Master') $(this).show();    
                        if (liText == 'Add Legal Case') $(this).show();
                        if (liText == 'Legal Case Approve') $(this).show();                                           
                        if (liText == 'Legal Case Issue Letter') $(this).show();
                        if (liText == 'Legal Case Hearing') $(this).show();
                        if (liText == 'Legal Case Bill') $(this).show();
                        if (liText == 'Legal Case Bill Payment') $(this).show();
                        if (liText == 'Legal Case History') $(this).show();
                        if (liText == 'Legal Case Summary') $(this).show();  
                    });
                    $("#nvtanb").show();
                }

                //JMD
                if ($('#rolename').val() == "JMD") {
                    $("#nvtanb li").each(function () {
                        var liText = $(this).text();
                        if (liText == 'Legal Case JMD Approve') $(this).show();
                        if (liText == 'Legal Case Bill JMD Approve') $(this).show();
                        if (liText == 'Legal Case History') $(this).show();
                        if (liText == 'Legal Case Summary') $(this).show();
                        
                    });
                    $("#nvtanb").show();
                }
                //HOD
                if ($('#rolename').val() == "HOD") {
                    $("#nvtanb li").each(function () {
                        var liText = $(this).text();
                        if (liText == 'Legal Case Bill HOD Approve') $(this).show();
                        if (liText == 'Legal Case History') $(this).show();
                        if (liText == 'Legal Case Summary') $(this).show();
                    });
                    $("#nvtanb").show();
                }
                //MD
                if ($('#rolename').val() == "MD") {
                    $("#nvtanb li").each(function () {
                        var liText = $(this).text();
                        if (liText == 'Legal Case MD Approve') $(this).show();
                        if (liText == 'Legal Case History') $(this).show();
                        if (liText == 'Legal Case Summary') $(this).show();
                    });
                    $("#nvtanb").show();
                }
               

                //IT

                if ($('#rolename').val() == "IT")
                {
                    $("#nvtanb li").each(function () {
                        var liText = $(this).text();
                        if (liText == 'IT Approve') $(this).show();
                        if (liText == 'Complaint History') $(this).show();
                    });
                }
               //DEPTHEAD
                if ($('#rolename').val() == "Commplaint HOD") {
                    $("#nvtanb li").each(function () {
                        var liText = $(this).text();
                        if (liText == 'HOD Approve') $(this).show();
                        if (liText == 'Complaint History') $(this).show();
                    });
                }
            },
            failure: function (response) {
                 alert(response.d);
            },
            error: function (response) {
                alert(response);
            }
        });
    }
</script>
