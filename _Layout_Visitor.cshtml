<script>
    $(document).ready(function() {
        var currentUrl = window.location.pathname; // Get the current page URL
        
        // Loop through all navigation items and check if the link matches the current URL
        $("#nvtanb li a").each(function() {
            var link = $(this).attr("href"); // Get the href attribute of the link
            if (link === currentUrl || currentUrl.startsWith(link)) {
                // Add 'active' class to the matching menu item
                $(this).closest("li").addClass("active");
            }
        });
    });
</script>
<script>
    $("#nvtanb li").on("click", function () {
        $(this).addClass("active");
        $("li").removeClass("active");
    })
    $("#navcontrl").on("click", function () {
        $(".sidebarlft").toggleClass("closebox");
        $(".rightBar").toggleClass("openbox");
    });

    $("#navcontrlr").on("click", function () {
        $(".sidebarlft").toggleClass("closebox");
        $(".rightBar").toggleClass("openbox");
    });
</script>
<script>
    (function ($) {
        $(window).on("load", function () {
            $("body").mCustomScrollbar({
                theme: "minimal"
            });
        });
    })(jQuery);
</script>
