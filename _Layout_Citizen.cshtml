<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<input type="hidden" id="legal_id" />
<input type="hidden" id="user_id" />
<input type="hidden" id="user_name" />
<input type="hidden" id="rooturl" />
<input type="hidden" id="rolename" />
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mumbai - Pune Expressway (Missing Link) Project : Complaint Management System</title>
    <link href="@Url.Content("~/Content/css/bootstrap.min.css")" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/css/fontawesome-free/css/all.min.css")" />
    <link href="@Url.Content("~/Content/css/style1.css")" type="text/css" rel="stylesheet" />
    @*<link rel="stylesheet" href="~/NSB/plugins/datatables/dataTables.bootstrap.css" type="text/css" />*@
    <script src="@Url.Content("~/Content/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/Content/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Content/js/Global_Function.js")"></script>


    <!-- DataTables -->
    <link rel="stylesheet" href="~/NSB/plugins/datatables/dataTables.bootstrap.css" type="text/css" />

    <link href="~/NSB/plugins/datatables/jquery.dataTables.css" rel="stylesheet" />


    <!-- iCheck -->
    <link rel="stylesheet" href="~/NSB/plugins/iCheck/flat/blue.css" type="text/css" />
    <!-- Morris chart -->
    <link rel="stylesheet" href="~/NSB/plugins/morris/morris.css" type="text/css" />
    <!-- jvectormap -->
    <link rel="stylesheet" href="~/NSB/plugins/jvectormap/jquery-jvectormap-1.2.2.css" type="text/css" />
    <!-- Date Picker -->
    <link rel="stylesheet" href="~/NSB/plugins/datepicker/datepicker3.css" type="text/css" />
    <!-- Daterange picker -->
    <link rel="stylesheet" href="~/NSB/plugins/daterangepicker/daterangepicker.css" type="text/css" />
    <!-- bootstrap wysihtml5 - text editor -->
    <link rel="stylesheet" href="~/NSB/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.min.css" type="text/css" />
    <!-- jQueryUI jquery-ui -->
    <link rel="stylesheet" href="~/NSB/plugins/jQueryUI/jquery-ui.css" type="text/css" />


</head>
<body>
    <header id="headhight">
        <div class="headshadow">
            <img src="@Url.Content("~/Content/images/logo-complaint.png")" class="img-responsive" alt=" " />
            <div class="headtitle">Complaint Management System</div>
            <div class="clearfix"></div>
        </div>
    </header>
    <!-- Header close -->
    <div class="container-fluid">
        <div class="row">
            <div class="sidebarlft" id="navheight">
                <div id="navcontrl"></div>
                <ul id="nvtanb">
                    <li class="active"><a href="@Url.Action("Complaint_Master","Home")">Add Complaint</a></li>
                    <li><a href="@Url.Action("Complaint_View","Home")">View Complaint</a></li>
                    @*<li><a href="@Url.Action("Complaint_IT_Approve","Home")">IT Approve</a></li>
                    <li><a href="@Url.Action("Complaint_HOD_Approve","Home")">HOD Approve</a></li>
                    <li><a href="@Url.Action("Complaint_History","Home")">Complaint History</a></li>*@
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="rightBar" id="pagecontent" style="overflow:auto;">
                <div id="content">
                    <div style="text-align:right" class="container-fluid topbar-back">
                        <div style="text-align:right" class="row">
                            <div id="emp_name" style="text-align:right" class="col-md-12">
                                <span class="hidden-xs"><a href="#"></a> | </span><a href="@Url.Action("User_Login","Login")">Logout</a>

                            </div>
                        </div>
                    </div>
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div class="clearfix"></div>
    <footer class=""> Designed & Developed by <a href="https://www.ceinsys.com" target="_blank"><img src="@Url.Content("~/Content/images/ceinsys-logo.jpg")" height="25" alt=" " /></a> </footer>



    <script src="@Url.Content("~/Content/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/Content/js/bootstrap.min.js")"></script>

    <!-- DataTables -->
    <script src="~/NSB/plugins/datatables/jquery.dataTables.min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/datatables/dataTables.bootstrap.min.js" type="text/javascript"></script>
    <script src="@Url.Content("~/Content/js/Chart.min.js")"></script>
    <!-- Morris.js charts -->
    <script src="~/NSB/Scripts/raphael-min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/morris/morris.min.js" type="text/javascript"></script>
    <!-- Sparkline -->
    <script src="~/NSB/plugins/sparkline/jquery.sparkline.min.js" type="text/javascript"></script>
    <!-- jvectormap -->
    <script src="~/NSB/plugins/jvectormap/jquery-jvectormap-1.2.2.min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/jvectormap/jquery-jvectormap-world-mill-en.js" type="text/javascript"></script>
    <!-- jQuery Knob Chart -->
    <script src="~/NSB/plugins/knob/jquery.knob.js" type="text/javascript"></script>
    <!-- daterangepicker -->
    <script src="~/NSB/Scripts/moment.min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/daterangepicker/daterangepicker.js" type="text/javascript"></script>
    <!-- datepicker -->
    <script src="~/NSB/plugins/datepicker/bootstrap-datepicker.js" type="text/javascript"></script>
    <!-- Bootstrap WYSIHTML5 -->
    <script src="~/NSB/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js" type="text/javascript"></script>
    <!-- Slimscroll -->
    <script src="~/NSB/plugins/slimScroll/jquery.slimscroll.min.js" type="text/javascript"></script>
    <!-- FastClick -->
    <script src="~/NSB/plugins/fastclick/fastclick.js" type="text/javascript"></script>

    <script>
        $("#nvtanb li").on("click", function () {
            $(this).addClass("active");
            $("li").removeClass("active");
        })
        $("#navcontrl").on("click", function () {
            $(".sidebarlft").toggleClass("closebox");
            $(".rightBar").toggleClass("openbox");
        });
    </script>
    <script>
        function resize1() {
            var heights = window.innerHeight;
            var pdhead = document.getElementById("headhight");
            var nhadhgt = pdhead.offsetHeight;
            document.getElementById("navheight").style.height = heights - nhadhgt - 48 + "px";
            document.getElementById("pagecontent").style.height = heights - nhadhgt - 48 + "px";
        }
        resize1();
        document.getElementsByTagName("BODY")[0].onresize = function () {
            var heights = window.innerHeight;
            var pdhead = document.getElementById("headhight");
            var nhadhgt = pdhead.offsetHeight;
            document.getElementById("navheight").style.height = heights - nhadhgt - 48 + "px";
            document.getElementById("pagecontent").style.height = heights - nhadhgt - 48 + "px";
        };
    </script>
    </div>
</body>
</html>







