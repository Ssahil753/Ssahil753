<body>
    <form>
         <div id="ctl16_navCommon" class="navbar navbar-inverse navbar-fixed-top">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>                   
                </div>                
            </div>
        </div>
        <!-- Modal -->
        <div id="myLoginModal" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Login Page</h4>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12 col-lg-12">
                                <div class="form-group">
                                    <label>Login Name</label>
                                    <input id="txtMISDashboardLoginId" type="text" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-lg-12">
                                <div class="form-group">
                                    <label>Password</label>
                                    <input id="txtMISDashboardPassword" type="password" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnMISDashboardLogin">Login</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Modal -->
        <div id="myChangePassModal" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Change Password</h4>
                    </div>
                    <div class="modal-body">

                        <div class="row">
                            <div class="col-md-12 col-lg-12">
                                <div class="form-group">
                                    <label>Old Password</label>
                                    <input type="password" class="form-control MY_OLD_PASSWORD" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-lg-12">
                                <div class="form-group">
                                    <label>New Password</label>
                                    <input type="password" class="form-control MY_NEW_PASSWORD" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-lg-12">
                                <div class="form-group">
                                    <label>Retype Password</label>
                                    <input type="password" class="form-control MY_RETYPE_PASSWORD" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary MY_CHANGE_PASSWORD_BUTTON">Change Password</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid body-content">
            <div class="panel panel-primary" style="margin-top: 200px;">
                <div class="panel-heading">
                <h3 class="panel-title">Login</h3>
                <span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
                </div>
                <div id="pnlWorkingArea" class="panel-body">
                @RenderBody()
                </div>                                
            </div>        
            <footer>
                <p>&copy; Milind Somnathe.</p>
            </footer>
        </div>
    </form>
    <script src="~/NSB/Scripts/jquery-1.10.2.min.js" type="text/javascript"></script>
    <!-- jQuery UI 1.11.4 -->
    <script src="~/NSB/plugins/jQueryUI/jquery-ui.min.js" type="text/javascript"></script>

    <!-- Resolve conflict in jQuery UI tooltip with Bootstrap tooltip -->
    <script type="text/javascript">
        $.widget.bridge('uibutton', $.ui.button);
    </script>
    <script src="~/NSB/Scripts/bootstrap.min.js" type="text/javascript"></script>
    <!-- Select2 -->
    <script src="~/NSB/plugins/select2/select2.full.min.js" type="text/javascript"></script>
    <!-- DataTables -->
    <script src="~/NSB/plugins/datatables/jquery.dataTables.min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/datatables/dataTables.bootstrap.min.js" type="text/javascript"></script>
    <!-- Morris.js charts -->
    <script src="~/NSB/Scripts/raphael-min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/morris/morris.min.js" type="text/javascript"></script>
    <!-- Sparkline -->
    <script src="~/NSB/plugins/sparkline/jquery.sparkline.min.js" type="text/javascript"></script>
    <!-- jvectormap -->
    <script src="~/NSB/plugins/jvectormap/jquery-jvectormap-1.2.2.min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/jvectormap/jquery-jvectormap-world-mill-en.js" type="text/javascript"></script>
    <!-- jQuery Knob Chart -->
    <script src="~/NSB/plugins/knob/jquery.knob.js" type="text/javascript"></script>
    <!-- daterangepicker -->
    <script src="~/NSB/Scripts/moment.min.js" type="text/javascript"></script>
    <script src="~/NSB/plugins/daterangepicker/daterangepicker.js" type="text/javascript"></script>
    <!-- datepicker -->
    <script src="~/NSB/plugins/datepicker/bootstrap-datepicker.js" type="text/javascript"></script>
    <!-- Bootstrap WYSIHTML5 -->
    <script src="~/NSB/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js" type="text/javascript"></script>
    <!-- Slimscroll -->
    <script src="~/NSB/plugins/slimScroll/jquery.slimscroll.min.js" type="text/javascript"></script>
    <!-- FastClick -->
    <script src="~/NSB/plugins/fastclick/fastclick.js" type="text/javascript"></script>
    @*<script src="~/NSB/Scripts/Utility.js" type="text/javascript"></script>*@
    @*<script src="~/NSB/Scripts/PrintUtility.js" type="text/javascript"></script>*@
    @*<script src="~/NSB/Scripts/NSBUserSite.js?v=4e4e3a0314934d6aa4978f98d57d74d8" type="text/javascript"></script>*@
    <script src="~/NSB/Scripts/Site.js" type="text/javascript"></script>
    @*<script src="~/NSB/Pages/Scripts/OPDRegistrationRenewal.aspx.js" type="text/javascript"></script>*@
    
</body>
</html>