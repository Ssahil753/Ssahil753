<script>
    function Fill_Department() {
        var Data =
        {
            Id: '',            
        };
        $.ajax({
            url: rootUrl + "api/Visitor_Master/Fill_Department",
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(Data),
            success: function (data) {
                
                var s = '';
                var s = '<option value="-1">---Select---</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].id + '">' + data[i].dept_Name + '</option>';
                }
                $("#Department").html(s);
            }
        }
        );
    };
</script>
<script>
    function Fill_Employee() {
        var Data =
        {
            Emp_Id: '',
        };
        $.ajax({
            url: rootUrl + "api/Visitor_Master/Fill_Employee",
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(Data),
            success: function (data) {
                
                var s = '';
                var s = '<option value="-1">---Select---</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].emp_Id + '">' + data[i].emp_Name + '</option>';
                }
                $("#Whom_To_Meet").html(s);
            }
        }
        );
    };
</script>

<script>
    function Print() {
        var printButton = document.getElementById("Edit");
        //Set the print button visibility to 'hidden'
        printButton.style.visibility = 'hidden';
        var prtContent = document.getElementById("Print");
        var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
        WinPrint.document.write(prtContent.innerHTML);       
