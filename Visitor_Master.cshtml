 </script>
<script>
    // Function to capitalize the first letter of each word
    function capitalizeWords(event) {
        let inputValue = event.target.value;
        // Capitalizing the first letter of each word and making the rest lowercase
        event.target.value = inputValue
            .split(' ')  // Split the input by spaces into an array of words
            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())  // Capitalize each word
            .join(' ');  // Join the words back with a space
    }
</script>
<script type="text/javascript">
    function Insert_Visitor() 
    {
        var res = Validate();
        if (res == false) {
            return false;
        }
        
        var Data =
        {
            Visitor_Name: $('#Visitor_Name').val(),
            Email_Id: $('#Email_Id').val(),
            Mobile_No: $('#Mobile_No').val(),
            Address: $('#Address').val(),
            Whom_To_Meet: $('#Whom_To_Meet').val(),
            Dept_Id: $('#Department').val(),
            Purpose_Of_Visit: $('#Purpose_Of_Visit').val(),
            Category:$('#Category').val(),
            Electronic_Accessories: $('#Electronic_Accessories').val(),          
            Make: $('#Make').val(),
            Serial_Number: $('#Serial_Number').val(),
            Photo :  $("#imgCapture")[0].src ,           
        };
        $.ajax({
            url: rootUrl + "api/Visitor_Master/Insert_Visitor",
            type: "Post",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(Data),
            success: function (result) {                
                    alert("Record is Saved Successfully.");               
                    Clear_Data();
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        });
    }
</script>

<script type="text/javascript">
    function Clear_Data() 
    {
        $('#Visitor_Name').val("");
        $('#Email_Id').val("");
        $('#Mobile_No').val("");
        $('#Address').val("");
       // $('#Whom_To_Meet').val("");    
        $('#Save').val("Add");
    }
</script>

<script type="text/javascript">
    function Validate() {
        var isValid = true;
       
        var Photo = $.trim($("#data_uri").val()).length;        
        if (Photo == 0) 
        {
            alert('Photo should not be blank.');
            $('#imgCapture').focus();
            isValid = false;
            return false;
        }
           var Visitor_Name = $.trim($("#Visitor_Name").val()).length;
    if (Visitor_Name == 0) {
        alert('Name should not be blank.');
        $('#Visitor_Name').focus();
        isValid = false;
        return false;
    }

    // Validate Name to accept only alphabets (allow spaces, e.g., for first and last name)
    var namePattern = /^[A-Za-z\s]+$/;
    if (!namePattern.test($("#Visitor_Name").val())) {
        alert('Name should contain only alphabets.');
        $('#Visitor_Name').focus();
        isValid = false;
        return false;
    }

    var Mobile_No = $.trim($("#Mobile_No").val()).length;
    if (Mobile_No == 0) {
        alert('Mobile No should not be blank.');
        $('#Mobile_No').focus();
        isValid = false;
        return false;
    }

    // Validate Mobile No to accept only numeric values (no alphabets, special characters)
    var mobilePattern = /^[0-9]+$/;
    if (!mobilePattern.test($("#Mobile_No").val())) {
        alert('Mobile No should contain only numeric values.');
        $('#Mobile_No').focus();
        isValid = false;
        return false;
    }

        var Address = $.trim($("#Address").val()).length;
        if (Address == 0) {
            alert('Address Type should not be blank.');
            $('#Address').focus();
            isValid = false;
            return false;
        }
        var Department = $('#Department').val();
        if (Department == "-1") {
            alert('Please Select Department.');
            $('#Department').focus();
            isValid = false;
            return false;
        }

        var Purpose_Of_Visit = $('#Purpose_Of_Visit').val();
        if (Purpose_Of_Visit   == "-1") {
            alert('Please Select Purpose Of Visit.');
            $('#Purpose_Of_Visit').focus();
            isValid = false;
            return false;
        }

        var Category = $('#Category').val();
        if (Category   == "-1") {
            alert('Please Select Category.');
            $('#Category').focus();
            isValid = false;
            return false;
        }


        var Whom_To_Meet = $('#Whom_To_Meet').val();
        if (Whom_To_Meet == "-1") {
            alert('Please Select Whom_To_Meet.');
            $('#Whom_To_Meet').focus();
            isValid = false;
            return false;
        }  
        var Email_Id = $.trim($("#Email_Id").val());
        if (Email_Id == "") {
        alert('Email should not be blank.');
        $('#Email_Id').focus();
        isValid = false;
        return false;
    }
   
        return isValid;
    }
</script>

<script type="text/javascript">
    function Authenticate() {
        var token = sessionStorage.getItem("accessToken");
        if (token == null) {
            alert('Token has expired.');
            return false
        }
        $.ajax({
            type: "GET",
            url: basePath + "api/data/authenticate",
            dataType: 'json',
            async: false,
            beforeSend: function (xhr) {

                xhr.setRequestHeader('Authorization', 'Bearer ' + token);
            },
            success: function (result) {
                var total = result.length;
                if (total != 0) {
                    var UserAttributes = new Array();
                    UserAttributes = result.split("_");
                    $('#UserName').val(UserAttributes[0]);
                    $('#User_ID').val(UserAttributes[1]);
                    //$('#UserName').val(UserAttributes[0]);
                    $('#basePath').val(UserAttributes[3]);
                }
                //alert('User has Authenticated');
            }
        });
    }
</script>

