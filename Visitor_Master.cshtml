<script>
    // Function to ensure only alphabets and spaces in the Visitor Name field
    function validateVisitorName(event) {
        let inputValue = event.target.value;
        // Remove anything that is not an alphabet or space
        event.target.value = inputValue.replace(/[^a-zA-Z\s]/g, '');
    }

    // Function to ensure only numbers in the Mobile No field
    function validateMobileNo(event) {
        let inputValue = event.target.value;
        // Remove anything that is not a number
        event.target.value = inputValue.replace(/[^0-9]/g, '');
    }

    // Function to capitalize the first letter of each word in the Visitor Name
    function capitalizeWords(event) {
        let inputValue = event.target.value;
        event.target.value = inputValue.replace(/\b\w/g, function(match) {
            return match.toUpperCase();
        });
    }
</script>

